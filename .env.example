# ───── شبکه و دسترسی ─────
PORT=3000
# فقط برای توسعه: کلید ورود استاد. اگر خالی بماند، در هر اجرا یک کلید تصادفی در لاگ سرور چاپ می‌شود.
TEACHER_KEY=change-me-please
# مبدأهای مجاز WebSocket (با کاما جدا کنید). خالی = همه (فقط برای آزمایش)
ALLOWED_ORIGINS=

# ───── mediasoup ─────
# آدرس IP قابل دسترس برای مرورگرها (روی سرور واقعی: IP عمومی). روی همین دستگاه: 127.0.0.1
RTC_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_WORKERS=2
# هر worker یک پورت UDP و TCP می‌گیرد: RTC_PORT_MIN تا RTC_PORT_MIN+WORKERS-1
RTC_PORT_MIN=40000
RTC_PORT_MAX=40001
# سرورهای ICE/TURN به‌صورت آرایهٔ JSON (اختیاری)، مثال:
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=

# ───── محدودیت‌های کلاس ─────
MAX_SPEAKERS=3
MAX_ROOMS=50
MAX_PEERS_PER_ROOM=150
CHAT_BUFFER_SIZE=50
TEACHER_GRACE_SEC=90
HEARTBEAT_TIMEOUT_SEC=30
EMPTY_ROOM_TTL_SEC=120
